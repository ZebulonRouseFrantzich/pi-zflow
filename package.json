{
  "private": true,
  "name": "pi-zflow-workspace",
  "version": "0.1.0",
  "description": "pi-zflow — modular Pi harness customization suite — monorepo workspace",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "git clean -fdX packages/",
    "bootstrap": "npm install --workspaces",
    "test": "npm run test:all",
    "test:core": "npx tsx --test packages/pi-zflow-core/test/*.test.ts",
    "test:all": "sh -c 'set -e; for pkg in packages/*/; do test_dir=\"${pkg}test\"; if [ -d \"$test_dir\" ] && find \"$test_dir\" -maxdepth 1 -name \"*.test.ts\" -print -quit | grep -q .; then npx tsx --test \"$test_dir\"/*.test.ts; fi; done'",
    "lint": "sh scripts/check-typescript-parse.sh",
    "lint:quick": "sh scripts/check-typescript-parse.sh 2>&1 | head -40",
    "check": "sh scripts/check-typescript-parse.sh"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-zflow"
  ],
  "dependencies": {
    "@mariozechner/pi-ai": "npm:@earendil-works/pi-ai@0.75.5",
    "@mariozechner/pi-coding-agent": "npm:@earendil-works/pi-coding-agent@0.75.5",
    "@mariozechner/pi-tui": "npm:@earendil-works/pi-tui@0.75.5",
    "pi-interview": "0.8.7",
    "pi-mono-auto-fix": "0.3.1",
    "pi-mono-context-guard": "1.7.3",
    "pi-mono-multi-edit": "1.7.3",
    "pi-mono-sentinel": "1.11.0",
    "pi-rtk-optimizer": "0.8.0",
    "pi-web-access": "0.10.7"
  },
  "pi": {
    "extensions": [
      "packages/pi-zflow/extensions",
      "packages/pi-zflow-artifacts/extensions",
      "packages/pi-zflow-profiles/extensions",
      "packages/pi-zflow-plan-mode/extensions",
      "packages/pi-zflow-agents/extensions",
      "packages/pi-zflow-review/extensions",
      "packages/pi-zflow-change-workflows/extensions",
      "packages/pi-zflow-runecontext/extensions",
      "packages/pi-zflow-compaction/extensions",
      "packages/pi-zflow-subagents-bridge/extensions",
      "node_modules/pi-rtk-optimizer/index.ts",
      "node_modules/pi-web-access/index.ts",
      "node_modules/pi-interview/index.ts",
      "node_modules/pi-mono-sentinel/index.ts",
      "node_modules/pi-mono-context-guard/index.ts",
      "node_modules/pi-mono-multi-edit/index.ts",
      "node_modules/pi-mono-auto-fix/index.ts"
    ],
    "skills": [
      "packages/pi-zflow-agents/skills",
      "node_modules/pi-web-access/skills"
    ],
    "prompts": [
      "packages/pi-zflow-agents/prompts"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
