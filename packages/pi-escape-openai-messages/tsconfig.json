{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "outDir": "./src",
    "rootDir": "./src",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "isolatedModules": false,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
